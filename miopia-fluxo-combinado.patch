+.tabela { margin: 0; font-weight: 700; letter-spacing: 0.08em; line-height: 1.1; }
+.t1 { font-size: 48px; } .t2 { font-size: 28px; color: #3a4552; } .t3 { font-size: 18px; color: var(--suave); }
+.ajuda { color: var(--suave); font-size: 13px; margin-top: 14px; }
+.estado { color: var(--suave); } .erro { color: var(--alerta); }
+.titulo { color: var(--suave); font-size: 13px; margin: 0 0 6px; }
+.resumo { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
+h2 { font-size: 13px; font-weight: 600; color: var(--suave); margin: 18px 0 4px; }
+.sinais { list-style: none; margin: 0; padding: 0; }
+.sinais li { padding: 8px 0; border-top: 1px solid var(--linha); }
+.sinais li:first-child { border-top: 0; }
+.linha-sinal { display: flex; align-items: baseline; gap: 8px; }
+.marcador { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--linha); flex: none; transform: translateY(1px); }
+.nome { font-weight: 600; } .status { margin-left: auto; color: var(--suave); font-size: 12px; white-space: nowrap; }
+.ausente .nome { color: var(--suave); font-weight: 500; }
+.alerta .marcador { background: var(--alerta); border-color: var(--alerta); }
+.apuracao .marcador { background: var(--apuracao); border-color: var(--apuracao); }
+.trecho { display: inline-block; margin: 6px 6px 0 18px; padding: 2px 8px; border-radius: var(--raio); font-family: Georgia, serif; font-size: 13px; }
+.alerta .trecho { background: var(--alerta-fundo); color: var(--alerta); }
+.apuracao .trecho { background: var(--apuracao-fundo); color: var(--apuracao); }
+.porque { margin: 4px 0 0 18px; color: var(--suave); font-size: 13px; }
+.checklist { margin: 0; padding-left: 20px; } .checklist li { margin: 3px 0; }
+.modelo { margin-top: 20px; padding-top: 10px; border-top: 1px solid var(--linha); font-size: 13px; }
+.modelo-linha { display: flex; justify-content: space-between; color: var(--suave); } .modelo-linha strong { color: var(--tinta); }
+.barra { height: 6px; background: var(--linha); border-radius: 3px; margin-top: 6px; }
+.barra div { height: 6px; border-radius: 3px; background: var(--suave); width: 0; }
+.faixa { margin: 6px 0; color: var(--suave); }
+.partes { list-style: none; padding: 0; margin: 8px 0; color: var(--suave); }
+.partes li { display: flex; justify-content: space-between; padding: 2px 0; gap: 8px; }
+#sinais-modelo li { display: block; } #sinais-modelo li span { display: block; } #sinais-modelo li span + span { font-size: 12px; }
+.aviso { color: var(--suave); font-size: 12px; } summary { cursor: pointer; color: var(--suave); }
+.comunidade { margin-top: 14px; padding-top: 6px; border-top: 1px solid var(--linha); }
+.votos { display: flex; gap: 8px; }
+.voto { flex: 1; background: transparent; border: 1px solid var(--linha); border-radius: var(--raio); padding: 6px 4px; font: inherit; cursor: pointer; }
+.voto[aria-pressed="true"] { border-color: var(--lente); color: var(--lente); font-weight: 600; }
+.rodape { padding: 8px 16px 12px; border-top: 1px solid var(--linha); font-size: 12px; }
+.rodape a { color: var(--suave); }
