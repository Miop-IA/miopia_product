index 0000000..a06ea3e
--- /dev/null
+++ b/backend/miopia_ml/features.py
@@ -0,0 +1,169 @@
+"""Extração de features do Miop.IA.
+
+Este módulo é usado tanto no treino (treinar.py) quanto na API (api/main.py).
+Qualquer mudança aqui vale para os dois lados, o que garante que o modelo
+recebe na API exatamente o mesmo tipo de número que viu no treino.
+"""
+import re
+from collections import Counter
+
+import numpy as np
+import spacy
+from spacy.lang.pt.stop_words import STOP_WORDS
+from spellchecker import SpellChecker
+
+TOK = re.compile(r"[a-zà-ú0-9]+", re.I)
+STOP = set(STOP_WORDS)
+
+FEATURES_ESTILO = [
+    "pausalidade", "emotividade", "caixa_alta", "dens_verbos", "dens_substantivos",
+    "dens_adjetivos", "dens_adverbios", "dens_pronomes", "mattr_25",
+    "erros_ortografia", "dens_modais", "dens_subj_imp", "dens_pron_1_2_sing", "dens_pron_1_plur",
+]
+
+NOMES_SIMPLES = {
+    "pausalidade": "Pontuação por frase",
+    "emotividade": "Linguagem emotiva",
+    "caixa_alta": "Palavras em CAIXA ALTA",
+    "dens_verbos": "Proporção de verbos",
+    "dens_substantivos": "Proporção de substantivos",
+    "dens_adjetivos": "Proporção de adjetivos",
+    "dens_adverbios": "Proporção de advérbios",
+    "dens_pronomes": "Proporção de pronomes",
+    "mattr_25": "Variedade de vocabulário",
+    "erros_ortografia": "Erros de ortografia",
+    "dens_modais": "Verbos como poder/dever",
+    "dens_subj_imp": "Imperativo e subjuntivo",
+    "dens_pron_1_2_sing": "Fala direta (eu/você)",
+    "dens_pron_1_plur": "Uso de “nós”",
+}
+
+MODAIS = {"poder", "dever", "precisar"}
+PRON_2SG = {"você", "tu", "te", "ti", "contigo", "teu", "tua"}
+PRON_1PL = {"nós", "nos", "conosco", "nosso", "nossa"}
+
+
+def normalizar(texto: str) -> str:
+    """Remove artefatos de formatação que não são estilo de escrita.
+
+    No Fake.Br, 92% das falsas têm espaços duplos e 0% das verdadeiras: é resto da
+    coleta. Aspas tipográficas também variam por site. Normalizar evita que o modelo
+    aprenda a origem do texto em vez do estilo.
+    """
+    t = str(texto)
+    t = re.sub(r"[“”«»]", '"', t)
+    t = re.sub(r"[‘’]", "'", t)
+    t = re.sub(r"\s+([,.;:!?])", r"\1", t)
+    t = re.sub(r"([.?!])([A-ZÀ-Ú])", r"\1 \2", t)
+    t = re.sub(r"\s+", " ", t).strip()
+    return t
+
+
+def truncar(texto: str, n_palavras: int) -> str:
+    """Mantém frases inteiras do início até passar de n_palavras."""
+    frases = re.split(r"(?<=[.!?])\s+", texto)
+    saida, cont = [], 0
+    for f in frases:
+        saida.append(f)
+        cont += len(TOK.findall(f))
+        if cont >= n_palavras:
+            break
+    return " ".join(saida)
+
+
+def contar_palavras(texto: str) -> int:
+    return len(TOK.findall(str(texto)))
+
+
+def mattr(texto: str, janela: int = 25) -> float:
+    """Média do TTR em janelas deslizantes; não depende do tamanho do texto."""
+    w = TOK.findall(str(texto).lower())
+    if len(w) < janela:
+        return np.nan
+    c = Counter(w[:janela])
+    tipos = [len(c)]
+    for i in range(janela, len(w)):
+        c[w[i]] += 1
+        sai = w[i - janela]
+        c[sai] -= 1
+        if c[sai] == 0:
+            del c[sai]
+        tipos.append(len(c))
+    return float(np.mean(tipos) / janela)
+
+
+def limpar(texto: str) -> str:
+    """Texto para o TF-IDF de palavras: minúsculas, só letras, sem stopwords."""
+    t = re.sub(r"[^a-zà-ú\s]", " ", str(texto).lower())
+    return " ".join(p for p in t.split() if p not in STOP and len(p) > 2)
+
+
+class Extrator:
+    """Calcula, numa única passada do spaCy, o estilo e o texto lematizado."""
+
+    def __init__(self, modelo_spacy: str = "pt_core_news_lg"):
+        self.nlp = spacy.load(modelo_spacy, disable=["ner"])
+        self.spell = SpellChecker(language="pt")
+
+    def _do_doc(self, doc) -> dict:
+        tokens = [t for t in doc if not t.is_space]          # sem tokens de espaço
+        palavras = [t for t in tokens if not t.is_punct]
+        n_tok = max(len(tokens), 1)
+        n_pal = max(len(palavras), 1)
+        n_frases = max(len(list(doc.sents)), 1)
+
+        pos = Counter(t.pos_ for t in palavras)
+        n_verb = pos["VERB"] + pos["AUX"]
+        n_subst = pos["NOUN"] + pos["PROPN"]
+        n_adj, n_adv, n_pron = pos["ADJ"], pos["ADV"], pos["PRON"]
+        n_pont = sum(1 for t in tokens if t.is_punct)
+        n_caixa = sum(1 for t in palavras if t.text.isupper() and len(t.text) > 1)
+
+        modais = subj_imp = p12 = p1p = 0
+        candidatos = []
+        for i, t in enumerate(palavras):
+            lem = t.lemma_.lower()
+            mood, pessoa, num = t.morph.get("Mood"), t.morph.get("Person"), t.morph.get("Number")
+            if t.pos_ in ("VERB", "AUX"):
+                if lem in MODAIS or (lem == "ter" and i + 1 < len(palavras) and palavras[i + 1].lower_ in ("que", "de")):
+                    modais += 1
+                if "Sub" in mood or "Imp" in mood:
+                    subj_imp += 1
+            if t.pos_ in ("PRON", "DET"):
+                if (("1" in pessoa or "2" in pessoa) and "Sing" in num) or t.lower_ in PRON_2SG:
+                    p12 += 1
+                if ("1" in pessoa and "Plur" in num) or t.lower_ in PRON_1PL:
+                    p1p += 1
+            if t.is_alpha and t.pos_ != "PROPN" and t.text.islower() and len(t.text) > 2:
+                candidatos.append(t.text)
+
+        lematizado = " ".join(
+            t.lemma_.lower() for t in palavras
+            if t.is_alpha and not t.is_stop and t.lemma_.lower() not in STOP and len(t.text) > 2
+        )
+        estilo = {
+            "pausalidade": n_pont / n_frases,
+            "emotividade": (n_adj + n_adv) / (n_subst + n_verb) if (n_subst + n_verb) else 0.0,
+            "caixa_alta": n_caixa / n_tok,
+            "dens_verbos": n_verb / n_tok,
+            "dens_substantivos": n_subst / n_tok,
+            "dens_adjetivos": n_adj / n_tok,
+            "dens_adverbios": n_adv / n_tok,
+            "dens_pronomes": n_pron / n_tok,
+            "mattr_25": mattr(doc.text),
+            "erros_ortografia": len(self.spell.unknown(candidatos)) / max(len(candidatos), 1),
+            "dens_modais": modais / n_pal,
+            "dens_subj_imp": subj_imp / n_pal,
+            "dens_pron_1_2_sing": p12 / n_pal,
+            "dens_pron_1_plur": p1p / n_pal,
+        }
+        return {"estilo": estilo, "lematizado": lematizado}
+
+    def processar(self, textos, batch_size: int = 64):
+        """Recebe textos já normalizados e truncados. Devolve (matriz de estilo, lematizados)."""
+        estilos, lems = [], []
+        for doc in self.nlp.pipe(textos, batch_size=batch_size):
+            r = self._do_doc(doc)
+            estilos.append([r["estilo"][f] for f in FEATURES_ESTILO])
+            lems.append(r["lematizado"])
+        return np.array(estilos, dtype=float), lems
