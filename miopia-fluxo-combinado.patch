+"""Modelo do Miop.IA: três modelos de base combinados por stacking.
+
+- svm_caracteres: TF-IDF de n-gramas de caracteres (3 a 5) sobre o texto normalizado
+- svm_palavras:   TF-IDF de palavras (1 e 2 gramas) sobre o texto limpo
+- estilo_temas:   XGBoost sobre 14 features de estilo + temas LDA/NMF (k = 8 e 30)
+O meta-modelo é uma regressão logística sobre as probabilidades fora-do-fold.
+"""
+import numpy as np
+import xgboost
+from sklearn.calibration import CalibratedClassifierCV
+from sklearn.decomposition import NMF, LatentDirichletAllocation
+from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer
+from sklearn.linear_model import LogisticRegression
+from sklearn.metrics import f1_score
+from sklearn.model_selection import GroupKFold
+from sklearn.preprocessing import StandardScaler
+from sklearn.svm import LinearSVC
+from xgboost import XGBClassifier
+
+from .features import FEATURES_ESTILO
+
+SEED = 42
+EPS = 1e-12
+PARAMS_XGB = dict(colsample_bytree=0.403, learning_rate=0.115, max_depth=2, min_child_weight=8,
+                  n_estimators=874, reg_lambda=3.80, subsample=0.842)
+C_SVM = {"caracteres": 1.0, "palavras": 3.0}
+BASES = ["svm_caracteres", "svm_palavras", "estilo_temas"]
+
+
+def _logit(p):
+    p = np.clip(p, 1e-4, 1 - 1e-4)
+    return np.log(p / (1 - p))
+
+
+class Temas:
+    """LDA ou NMF ajustado no treino; transforma qualquer texto em k + 3 features."""
+
+    def __init__(self, metodo: str, k: int):
+        self.metodo, self.k = metodo, k
+
+    def fit(self, textos):
+        if self.metodo == "lda":
+            self.vec = CountVectorizer(max_features=3000, min_df=5, max_df=0.5)
+            self.mod = LatentDirichletAllocation(n_components=self.k, learning_method="online",
+                                                 max_iter=15, random_state=SEED, n_jobs=-1)
+        else:
+            self.vec = TfidfVectorizer(max_features=3000, min_df=5, max_df=0.5)
+            self.mod = NMF(n_components=self.k, init="nndsvda", max_iter=400, random_state=SEED)
+        self.mod.fit(self.vec.fit_transform(textos))
+        H = self.mod.components_
+        self.beta = H / H.sum(axis=1, keepdims=True)
+        self.HHt = H @ H.T
+        return self
+
+    def transform(self, textos):
+        M = self.vec.transform(textos).tocsr()
+        W = self.mod.transform(M)
+        H, k, n = self.mod.components_, self.k, M.shape[0]
+        theta = W / (W.sum(axis=1, keepdims=True) + EPS)
+        entropia = -(theta * np.log(theta + EPS)).sum(axis=1) / np.log(k)
+        lin, col = M.nonzero()
+        val = np.asarray(M[lin, col]).ravel()
+        if self.metodo == "lda":
+            p = np.einsum("nk,kn->n", theta[lin], self.beta[:, col])
+            ll = np.bincount(lin, weights=val * np.log(p + EPS), minlength=n)
+            ajuste = ll / np.maximum(np.asarray(M.sum(axis=1)).ravel(), 1)
+        else:
+            wh = np.einsum("nk,kn->n", W[lin], H[:, col])
+            cruz = np.bincount(lin, weights=val * wh, minlength=n)
+            m2 = np.asarray(M.multiply(M).sum(axis=1)).ravel()
+            wh2 = np.einsum("nk,kl,nl->n", W, self.HHt, W)
+            ajuste = np.sqrt(np.maximum(m2 - 2 * cruz + wh2, 0)) / np.sqrt(m2 + EPS)
+        return np.column_stack([theta, entropia, theta.max(axis=1), ajuste])
+
+
+class BlocoDenso:
+    """Estilo padronizado + temas LDA/NMF, entrada do XGBoost."""
+
+    def __init__(self, ks=(8, 30)):
+        self.ks = ks
+
+    def fit(self, E, lem):
+        self.mediana = np.nanmedian(E, axis=0)
+        self.sc = StandardScaler().fit(self._imputar(E))
+        self.temas = [Temas(m, k).fit(lem) for m in ("lda", "nmf") for k in self.ks]
+        A = [t.transform(lem) for t in self.temas]
+        self.sc_temas = [StandardScaler().fit(a) for a in A]
+        self.nomes = list(FEATURES_ESTILO) + [f"{t.metodo}{t.k}_{i}" for t in self.temas for i in range(t.k + 3)]
+        return self
+
+    def _imputar(self, E):
+        return np.where(np.isnan(E), self.mediana, E)
+
+    def transform(self, E, lem):
+        partes = [self.sc.transform(self._imputar(E))]
+        partes += [s.transform(t.transform(lem)) for t, s in zip(self.temas, self.sc_temas)]
+        return np.hstack(partes)
+
+
+def _vetorizador(tipo):
+    if tipo == "palavras":
+        return TfidfVectorizer(ngram_range=(1, 2), min_df=3, max_df=0.5, max_features=60000, sublinear_tf=True)
+    return TfidfVectorizer(analyzer="char_wb", ngram_range=(3, 5), min_df=5, max_features=60000, sublinear_tf=True)
+
+
+class ModeloMiopia:
+    def __init__(self, ks=(8, 30)):
+        self.ks = ks
+
+    # ---------- partes internas
+    def _fit_bases(self, X, y):
+        bases = {}
+        for tipo, chave in [("caracteres", "normal"), ("palavras", "limpo")]:
+            v = _vetorizador(tipo)
+            A = v.fit_transform(X[chave])
+            svm = CalibratedClassifierCV(LinearSVC(C=C_SVM[tipo], class_weight="balanced", max_iter=5000),
+                                         method="sigmoid", cv=3).fit(A, y)
+            bases[f"svm_{tipo}"] = (v, svm)
+        bloco = BlocoDenso(self.ks).fit(X["estilo"], X["lem"])
+        xgb = XGBClassifier(**PARAMS_XGB, eval_metric="logloss", random_state=SEED, n_jobs=-1)
+        xgb.fit(bloco.transform(X["estilo"], X["lem"]), y)
+        bases["estilo_temas"] = (bloco, xgb)
+        return bases
+
+    @staticmethod
+    def _prever_bases(bases, X):
+        out = {}
+        for nome in ("svm_caracteres", "svm_palavras"):
+            v, m = bases[nome]
+            chave = "normal" if nome == "svm_caracteres" else "limpo"
+            out[nome] = m.predict_proba(v.transform(X[chave]))[:, 1]
+        bloco, xgb = bases["estilo_temas"]
+        D = bloco.transform(X["estilo"], X["lem"])
+        out["estilo_temas"] = xgb.predict_proba(D)[:, 1]
+        return out, D
+
+    @staticmethod
+    def _sub(X, idx):
+        return {"normal": [X["normal"][i] for i in idx], "limpo": [X["limpo"][i] for i in idx],
+                "lem": [X["lem"][i] for i in idx], "estilo": X["estilo"][idx]}
+
+    # ---------- treino
+    def fit(self, X, y, grupos, n_folds=5, log=print):
+        """X = dict com listas 'normal', 'limpo', 'lem' e matriz 'estilo'."""
+        y = np.asarray(y)
+        oof = np.zeros((len(y), len(BASES)))
+        for f, (a, b) in enumerate(GroupKFold(n_folds).split(X["estilo"], y, groups=grupos)):
+            bases = self._fit_bases(self._sub(X, a), y[a])
+            p, _ = self._prever_bases(bases, self._sub(X, b))
+            oof[b] = np.column_stack([p[n] for n in BASES])
+            log(f"fold {f + 1}/{n_folds} pronto")
+        self.meta = LogisticRegression(max_iter=1000).fit(_logit(oof), y)
+        p_oof = self.meta.predict_proba(_logit(oof))[:, 1]
+        limiares = np.linspace(0.2, 0.8, 61)
+        f1s = [f1_score(y, p_oof >= t) for t in limiares]
+        self.limiar = float(limiares[int(np.argmax(f1s))])
+        self.f1_oof = float(max(f1s))
+        self.f1_oof_bases = {n: float(f1_score(y, oof[:, i] >= 0.5)) for i, n in enumerate(BASES)}
+        log(f"F1 fora-do-fold do stacking: {self.f1_oof:.3f} (limiar {self.limiar:.2f})")
+        self.bases = self._fit_bases(X, y)
+        log("modelo final treinado com todos os dados")
+        return self
+
+    # ---------- uso
+    def prever(self, X):
+        p_bases, D = self._prever_bases(self.bases, X)
+        Z = _logit(np.column_stack([p_bases[n] for n in BASES]))
+        p = self.meta.predict_proba(Z)[:, 1]
+        _, xgb = self.bases["estilo_temas"]
+        contrib = xgb.get_booster().predict(xgboost.DMatrix(D), pred_contribs=True)[:, :-1]
+        return p, p_bases, contrib, D
+
+    @property
+    def nomes_densos(self):
+        return self.bases["estilo_temas"][0].nomes
