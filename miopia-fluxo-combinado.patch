@@ -0,0 +1,66 @@
+"""Junta tudo: texto da notícia -> JSON que a extensão mostra."""
+import joblib
+import numpy as np
+
+from .features import NOMES_SIMPLES, FEATURES_ESTILO, Extrator, contar_palavras, limpar, normalizar, truncar
+from .regras import aplicar_regras
+
+MIN_PALAVRAS = 40
+AVISO = ("Não é um veredito: o modelo mede a semelhança de estilo e vocabulário com notícias falsas "
+         "do corpus Fake.Br (2016–2017). Use como pista e confira as fontes.")
+
+
+def faixa(p):
+    if p < 0.35:
+        return "parecida com notícias verdadeiras"
+    if p <= 0.65:
+        return "inconclusivo"
+    return "parecida com notícias falsas"
+
+
+class TextoCurto(ValueError):
+    pass
+
+
+class Analisador:
+    def __init__(self, caminho_artefato: str, modelo_spacy: str = "pt_core_news_lg"):
+        pacote = joblib.load(caminho_artefato)
+        self.modelo = pacote["modelo"]
+        self.n_trunc = pacote["n_trunc"]
+        self.info = pacote["info"]
+        self.extrator = Extrator(modelo_spacy)
+
+    def analisar(self, texto: str, titulo: str = "") -> dict:
+        completo = normalizar(f"{titulo}. {texto}" if titulo else texto)
+        n = contar_palavras(completo)
+        if n < MIN_PALAVRAS:
+            raise TextoCurto(f"O texto tem {n} palavras; são necessárias pelo menos {MIN_PALAVRAS}.")
+        curto = truncar(completo, self.n_trunc)
+        E, lem = self.extrator.processar([curto])
+        X = {"normal": [curto], "limpo": [limpar(curto)], "lem": lem, "estilo": E}
+        p, p_bases, contrib, D = self.modelo.prever(X)
+        p = float(np.clip(p[0], 0.01, 0.99))
+
+        c = contrib[0]
+        sinais = []
+        for j, nome in enumerate(FEATURES_ESTILO):
+            sinais.append({"nome": NOMES_SIMPLES[nome], "peso": float(c[j]),
+                           "nivel": "mais que o comum" if D[0, j] > 0 else "menos que o comum"})
+        n_est = len(FEATURES_ESTILO)
+        sinais.append({"nome": "Assunto e vocabulário (temas)", "peso": float(c[n_est:].sum()), "nivel": None})
+        sinais = sorted(sinais, key=lambda s: abs(s["peso"]), reverse=True)[:5]
+        for s in sinais:
+            s["direcao"] = "falsa" if s["peso"] > 0 else "verdadeira"
+
+        return {
+            "guia": aplicar_regras(completo),
+            "modelo": {
+                "semelhanca_falsas": round(p, 3),
+                "faixa": faixa(p),
+                "partes": {k: round(float(v[0]), 3) for k, v in p_bases.items()},
+                "sinais": sinais,
+                "aviso": AVISO,
+            },
+            "palavras_analisadas": contar_palavras(curto),
+            "versao_modelo": self.info.get("versao"),
+        }
