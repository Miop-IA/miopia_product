@@ -0,0 +1,95 @@
+"""Regras do guia de leitura: sinais que o leitor consegue reconhecer sozinho.
+
+Cada regra devolve os trechos do texto onde o sinal aparece. As regras são
+simples de propósito: o objetivo é ensinar o leitor, não substituir o modelo.
+"""
+import re
+
+SIGLAS_COMUNS = {"NASA", "ONU", "OMS", "STF", "STJ", "TSE", "PIB", "INSS", "SUS", "PMDB", "PSDB", "IBGE",
+                 "USP", "UFRJ", "FIFA", "CBF", "OAB", "CPI", "CPMI", "EUA", "EBC", "ANVISA", "PETROBRAS"}
+
+ALERTAS = [
+    {"id": "urgencia", "nome": "Urgência e pressa",
+     "porque": "A pressa impede você de checar antes de acreditar.",
+     "regex": r"\burgente\b|neste exato momento|antes que (apaguem|seja tarde|fique tarde)|tarde demais|não deixe para depois|última hora|corra\b"},
+    {"id": "compartilhar", "nome": "Pedido para compartilhar",
+     "porque": "Jornalismo informa; corrente pede que você espalhe.",
+     "regex": r"\b(compartilhe|compartilhem|repasse|repassem|divulgue|divulguem|espalhe|espalhem)\b(?:[ ,]+[^\s.!?,]+){0,4}"
+              r"|\b(avise|mande para|envie para) (sua|seus|os|as|todos)\b(?:[ ,]+[^\s.!?,]+){0,3}"},
+    {"id": "fonte_vaga", "nome": "Fonte vaga",
+     "porque": "Quem disse? Sem nome e cargo, não dá para conferir.",
+     "regex": r"um amigo (que|me)(?:[ ,]+[^\s.!?,]+){0,5}|me (confirmou|contou|garantiu)|\bdizem que\b|\bfontes? (afirmam|garantem|dizem)\b"
+              r"|ningu[eé]m est[aá] falando(?:[ ,]+[^\s.!?,]+){0,4}|[àa]s escondidas|a m[ií]dia (esconde|n[aã]o mostra)(?:[ ,]+[^\s.!?,]+){0,3}"},
+    {"id": "nos_contra_eles", "nome": "Nós contra eles",
+     "porque": "Indignação é usada para desligar o senso crítico.",
+     "regex": r"\beles (querem|v[aã]o)\b(?:[ ,]+[^\s.!?,]+){0,4}|roubam o povo|enganar o povo|contra o povo"},
+]
+
+APURACAO = [
+    {"id": "atribuicao", "nome": "Quem disse está identificado",
+     "porque": "Fontes identificadas podem ser procuradas e conferidas.",
+     "regex": r"\b(segundo (o|a|os|as|dados|pesquisa|levantamento|economistas|especialistas)|de acordo com|afirmou"
+              r"|informou|disse o|disse a|declarou)\b(?:[ ,]+[^\s.!?,]+){0,6}"},
+    {"id": "dados", "nome": "Números com origem",
+     "porque": "Números podem ser checados na fonte citada.",
+     "regex": r"\b\d+[,.]?\d*\s?(%|por cento|mil\b|milh[õo]es|bilh[õo]es)"},
+]
+
+CHECKLIST = [
+    "Procure o mesmo fato em outro veículo conhecido.",
+    "Leia além do título: ele diz o mesmo que o texto?",
+    "Busque a fonte original: a pesquisa, o órgão ou o post citado.",
+    "Confira a data: notícia antiga pode voltar fora de contexto.",
+    "Se o texto pede para repassar, pare e verifique antes.",
+]
+
+
+def _trechos(rx, texto, n=2):
+    saida = []
+    for m in re.finditer(rx, texto, flags=re.I):
+        s = m.group(0).strip(" ,;:\"'")
+        if s and s not in saida:
+            saida.append(s)
+        if len(saida) >= n:
+            break
+    return saida
+
+
+def _texto_gritado(texto):
+    """Sequências de 2+ palavras em caixa alta (ignorando siglas) e exclamações."""
+    trechos = []
+    for m in re.finditer(r"\b[A-ZÀ-Ú]{3,}(?:\s+[A-ZÀ-Ú]{2,})+\b", texto):
+        palavras = m.group(0).split()
+        if not all(p in SIGLAS_COMUNS for p in palavras):
+            trechos.append(m.group(0))
+    for m in re.finditer(r"\b[A-ZÀ-Ú]{5,}\b", texto):
+        if m.group(0) not in SIGLAS_COMUNS and not any(m.group(0) in t for t in trechos):
+            trechos.append(m.group(0))
+    exc = texto.count("!")
+    if exc >= 2:
+        trechos.append(f"! ({exc} vezes)")
+    return trechos[:3]
+
+
+def aplicar_regras(texto: str) -> dict:
+    alertas = []
+    for r in ALERTAS:
+        t = _trechos(r["regex"], texto)
+        alertas.append({"id": r["id"], "nome": r["nome"], "encontrado": bool(t), "trechos": t, "porque": r["porque"]})
+    g = _texto_gritado(texto)
+    alertas.append({"id": "gritado", "nome": "Texto gritado", "encontrado": bool(g), "trechos": g,
+                    "porque": "Caixa alta e exclamações são apelo emocional, não informação."})
+    apuracao = []
+    for r in APURACAO:
+        t = _trechos(r["regex"], texto)
+        apuracao.append({"id": r["id"], "nome": r["nome"], "encontrado": bool(t), "trechos": t, "porque": r["porque"]})
+    n_al = sum(a["encontrado"] for a in alertas)
+    n_ap = sum(a["encontrado"] for a in apuracao)
+    if n_al == 0 and n_ap > 0:
+        resumo = "Nenhum sinal de alerta encontrado, e o texto identifica fontes ou dados."
+    elif n_al == 0:
+        resumo = "Nenhum sinal de alerta encontrado, mas também nenhuma fonte ou dado identificado."
+    else:
+        palavra = "sinal de alerta encontrado" if n_al == 1 else "sinais de alerta encontrados"
+        resumo = f"{n_al} {palavra} e {n_ap} de apuração. Confira os trechos antes de acreditar."
+    return {"resumo": resumo, "alertas": alertas, "apuracao": apuracao, "checklist": CHECKLIST}
