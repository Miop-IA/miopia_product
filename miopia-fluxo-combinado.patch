+        if info.get("spacy") and info["spacy"] != s.spacy_model:
+            raise RuntimeError(f"Modelo treinado com spaCy {info['spacy']}, mas a API está com {s.spacy_model}.")
+        logger.info(f"Modelo carregado: versão {info.get('versao')}, teste {info.get('teste')}")
+    return _analisador
