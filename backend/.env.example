# Conexão com o banco de dados (Neon PostgreSQL em produção / Docker localmente)
DATABASE_URL=postgresql+psycopg2://usuario:senha@ep-exemplo.neon.tech/miopia_db?sslmode=require

# Limite diário de análises por utilizador (identificado por X-Client-Id)
LIMITE_DIARIO_POR_CLIENTE=50

# Origens permitidas no CORS (ID da extensão Chrome e ambiente de desenvolvimento local)
CORS_ORIGINS=["chrome-extension://SEU_CHROME_EXTENSION_ID", "http://localhost:3000"]

# Ambiente da aplicação (development | production | testing)
ENVIRONMENT=development
# Caminho do bundle do modelo (opcional; padrão: backend/models/stacking_miopia_v2.joblib).
# Bundle ausente, corrompido ou incompatível impede a API de iniciar.
# MODEL_PATH=models/stacking_miopia_v2.joblib
